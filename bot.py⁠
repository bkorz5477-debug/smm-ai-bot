@dp.message(F.voice)
async def process_voice_message(message: types.Message):
    user_id = message.from_user.id
    u = get_user_info(user_id)
    lang = u["lang"]
    t = TRANSLATIONS[lang]
    sub_active = is_sub_active(user_id, u)

    if not sub_active and u["attempts"] <= 0:
        await message.answer(t["out_of_limits"], parse_mode="Markdown")
        return

    status_msg = await message.answer(t["voice_processing"])

    try:
        file_info = await bot.get_file(message.voice.file_id)
        ogg_file = f"voice_{user_id}_{message.message_id}.ogg"
        await bot.download_file(file_info.file_path, ogg_file)

        with open(ogg_file, "rb") as audio_file:
            transcript = await whisper_client.audio.transcriptions.create(model="whisper-1", file=audio_file)
        recognized_text = transcript.text
        os.remove(ogg_file)

        await status_msg.edit_text(f"🗣 **Распознанный текст:**\n_«{recognized_text}»_\n\n🧠 Провожу детальный анализ...")
        await process_ai_logic(user_id, recognized_text, status_msg, sub_active, u)

    except Exception as e:
        logging.error(f"Voice Error: {e}")
        await notify_admin(str(e), user_id)
        await status_msg.edit_text("⚠️ Ошибка распознавания голосового файла.")

