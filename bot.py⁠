async def process_ai_logic(user_id: int, user_prompt: str, status_msg: types.Message, sub_active: bool, u: dict):
    if not sub_active:
        u["attempts"] -= 1

    lang = u["lang"]
    t = TRANSLATIONS[lang]

    if u["mode"] == "consultant":
        system_prompt = f"You are an elite CMO. Conduct a strategic audit. Answer strictly in language code '{lang}'."
    else:
        format_type = u['format']
        system_prompts = {
            "fmt_audit_hw": f"Ты строгий, профессиональный SMM Арт-директор и Ментор. Проведи глубокий аудит текста/ДЗ пользователя: 1) Поставь оценку от 1 до 10 по шкале завлекаемости (Хук, Полезнасть, CTA), 2) Выдели сильные стороны, 3) Укажи на ошибки и слабые места, 4) Напиши идеальную, доработанную версию текста. Отвечай на '{lang}'.",
            "fmt_omni": f"Ты SMM-архитектор. Адаптируй тему под 5 платформ: Instagram, Facebook, Telegram, LinkedIn, X. Отвечай на '{lang}'.",
            "fmt_abtest": f"Ты таргетолог. Создай 3 A/B варианта заголовка: 1) Боль/FOMO, 2) Выгода/ROI, 3) Интрига. Отвечай на '{lang}'.",
            "fmt_midjourney": f"Ты AI-арт директор. Напиши 2 детальных англоязычных промпта для Midjourney v6 (--ar 9:16 и --ar 1:1) + описание.",
            "fmt_instagram": f"Ты Instagram-стратег. Создай пост и визуал-концепцию. Отвечай на '{lang}'.",
            "fmt_reels": f"Ты сценарист Reels. Напиши вирусный сценарий с таймкодами и хуком. Отвечай на '{lang}'.",
            "fmt_strategy": f"Ты CMO. Разработай стратегию и воронку продаж. Отвечай на '{lang}'."
        }
        system_prompt = system_prompts.get(format_type, system_prompts["fmt_audit_hw"])

    try:
        response = await ai_client.chat.completions.create(
            model="deepseek-chat",
            messages=[
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt}
            ]
        )
        ai_text = response.choices[0].message.content
        balance_info = t["status_sub"] if sub_active else t["status_free"].format(attempts=u['attempts'])
        
        await status_msg.edit_text(
            f"📋 **Анализ и разбор контента:**\n\n{ai_text}\n\n"
            f"━━━━━━━━━━━━━━━━━━━\n{balance_info}",
            reply_markup=main_menu_keyboard(user_id),
            parse_mode="Markdown"
        )
    except Exception as e:
        logging.error(f"Error: {e}")
        await notify_admin(str(e), user_id)
        if not sub_active:
            u["attempts"] += 1
        await status_msg.edit_text("⚠️ Временный сбой API. Попробуйте еще раз.")

