@dp.message(Command("start"))
async def cmd_start(message: types.Message):
    user_id = message.from_user.id
    u = get_user_info(user_id)
    
    args = message.text.split()
    if len(args) > 1 and not u["referred_by"]:
        try:
            referrer_id = int(args[1])
            if referrer_id != user_id and referrer_id in user_data:
                u["referred_by"] = referrer_id
                ref_user = user_data[referrer_id]
                ref_user["attempts"] += 5
                ref_user["ref_count"] += 1
                await bot.send_message(chat_id=referrer_id, text="🎉 **Новый реферал!** Вам начислено **+5 генераций**!", parse_mode="Markdown")
        except Exception as e:
            logging.error(f"Ref error: {e}")

    lang = u["lang"]
    t = TRANSLATIONS[lang]
    sub_active = is_sub_active(user_id, u)
    status_str = t["status_sub"] if sub_active else t["status_free"].format(attempts=u['attempts'])
    await message.answer(t["welcome"].format(name=message.from_user.full_name, status=status_str), reply_markup=main_menu_keyboard(user_id), parse_mode="Markdown")

