def get_user_info(user_id: int):
    if user_id not in user_data:
        user_data[user_id] = {
            "attempts": DEFAULT_FREE_ATTEMPTS,
            "sub_until": None,
            "format": "fmt_audit_hw",
            "mode": "generation",
            "lang": "uk",
            "ref_count": 0,
            "referred_by": None,
            "attempts_spent_at": None,
            "promos_sent": []
        }
    return user_data[user_id]

def get_lang(user_id: int):
    return get_user_info(user_id)["lang"]

def is_sub_active(user_id: int, user_info: dict) -> bool:
    if user_id in VIP_USER_IDS:
        return True
    if user_info["sub_until"] and user_info["sub_until"] > datetime.now():
        return True
    user_info["sub_until"] = None
    return False

